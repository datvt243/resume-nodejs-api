{
  "name": "resume-nodejs-api",
  "main": "src/server.ts",
  "private": true,
  "version": "1.2.0",
  "description": "Resume API backend with rate limiting and Redis support",
  "scripts": {
    "dev-node": "ts-node -r tsconfig-paths/register src/server.ts",
    "dev": "nodemon -r tsconfig-paths/register --exec ts-node ./src/server.ts",
    "start:dev": "NODE_ENV=development npm run dev",
    "start:prod": "NODE_ENV=production npm run start",
    "env:setup": "cp .env.example .env",
    "env:dev": "cp .env.development .env",
    "env:prod": "cp .env.production .env",
    "babel-dev": "nodemon --exec babel-node src/server.js",
    "nodemon": "nodemon --exec babel-node ./src/server.js",
    "babel-start": "npm run remove-build && npm run build-babel && node ./build/server.js",
    "babel-build": "babel ./src -d ./build",
    "remove-build": "rm -rf build",
    "start": "npm run build && NODE_ENV=production node dist/server.js",
    "nodemon-start": "nodemon dist/server.js",
    "build-tsc": "tsc && npm run copy",
    "build": "tsc && npm run copy",
    "copy": "cp -R ./src/views ./src/public ./dist/",
    "test": "jest --passWithNoTests",
    "migrate:localize-text": "ts-node -r tsconfig-paths/register src/scripts/migrate-localize-text-fields.ts"
  },
  "author": "DatVT",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0 <23.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.10",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exit-hook": "^4.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.0",
    "express-session": "^1.18.0",
    "geoip-lite": "^1.4.10",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "mongoose": "^8.4.0",
    "multer": "^2.3.0",
    "open": "^10.1.0",
    "pdfkit": "^0.15.0",
    "pug": "^3.0.2",
    "puppeteer": "^22.13.1",
    "redis": "^4.6.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/exit-hook": "^2.2.1",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/http-status-codes": "^1.2.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "babel-plugin-module-resolver": "^5.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "_moduleAliases": {}
}
