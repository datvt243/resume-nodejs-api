# Environment Configuration
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=development

# Server Port
LOCAL_PORT=3001

# MongoDB Connection
# Option 1: Full connection string (recommended)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/resume-api?retryWrites=true&w=majority

# Option 2: Individual credentials (fallback - for backward compatibility)
MONGOBD_USER=
MONGOBD_PASSWORD=

# MongoDB connection pool size (optional, defaults: max=10, min=2)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production

# JWT Configuration
TOKEN_SECRET=your-jwt-secret-change-in-production
TOKEN_REFRESH=your-refresh-token-secret-change-in-production
TOKEN_EXP_IN=7d

# CORS allow-list (comma-separated origins), required for the httpOnly
# JWT cookie flow (issue #119) since `credentials: true` cannot be
# combined with a wildcard origin. Unset in development reflects the
# caller's origin; unset in production blocks every cross-origin request.
CORS_ORIGIN=https://your-frontend-domain.example

